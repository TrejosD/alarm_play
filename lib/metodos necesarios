cuando se inicia el app. recalcular datetime

Future<void> resyncAllAlarms() async {
  final alarms = await isar.alarms.where().findAll();

  for (final alarm in alarms) {
    if (!alarm.isActive) continue;

    alarm.nextTrigger = calculateNextTrigger(alarm);

    await scheduleAlarm(alarm);
  }
}

resolver URL / assets

AudioSource buildSource(Track track) {
  switch (track.type) {
    case TrackType.asset:
      return AudioSource.asset(track.path);

    case TrackType.file:
      return AudioSource.file(track.path);

    case TrackType.url:
      return AudioSource.uri(Uri.parse(track.path));
  }
}

