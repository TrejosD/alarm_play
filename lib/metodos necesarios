metodo togleAlarm switch
Future<void> toggleAlarm(Id id) async {
  final alarm = await isar.alarmModels.get(id);
  if (alarm == null) return;

  alarm.isActive = !alarm.isActive;

  await isar.writeTxn(() async {
    await isar.alarmModels.put(alarm);
  });

  if (alarm.isActive) {
    scheduleAlarm(alarm);
  } else {
    cancelAlarm(alarm.id);
  }
}

cuando suena una alarma. recalcula siguiente alarma cuando esta se repite

void onAlarmTriggered(Alarm alarm) async {
  if (alarm.repeatDays.isNotEmpty) {
    alarm.nextTrigger = calculateNextTrigger(alarm);

    await isar.writeTxn(() async {
      await isar.alarms.put(alarm);
    });

    scheduleAlarm(alarm);
  } else {
    alarm.isActive = false;

    await isar.writeTxn(() async {
      await isar.alarms.put(alarm);
    });
  }
  print("Next trigger: ${alarm.nextTrigger}");
}

